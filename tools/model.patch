-----------+    """Submit payment for organization credits"""
-----------+    org = await db.organizations.find_one({"id": org_id})
-----------+    if not org:
-----------+        raise HTTPException(status_code=404, detail="Organization not found")
-----------+    
-----------+    payment = OrganizationPayment(
-----------+        organization_id=org_id,
-----------+        amount=amount,
-----------+        credits_purchased=credits,
-----------+        screenshot_url=screenshot_base64,
-----------+    )
-----------+    
-----------+    await db.organization_payments.insert_one(payment.dict())
-----------+    return {"message": "Payment submitted for verification", "payment_id": payment.id}
-----------+
-----------+@api_router.post("/organizations/payments/{payment_id}/verify")
-----------+async def verify_organization_payment(payment_id: str, admin_id: str, approved: bool, reason: Optional[str] = None):
-----------+    """Admin verify organization payment"""
-----------+    payment = await db.organization_payments.find_one({"id": payment_id})
-----------+    if not payment:
-----------+        raise HTTPException(status_code=404, detail="Payment not found")
-----------+    
-----------+    if approved:
-----------+        # Add credits to organization
-----------+        await db.organizations.update_one(
-----------+            {"id": payment["organization_id"]},
-----------+            {
-----------+                "$inc": {"credits": payment["credits_purchased"], "total_credits_purchased": payment["credits_purchased"]},
-----------+                "$set": {"updated_at": datetime.utcnow()}
-----------+            }
-----------+        )
-----------+        status = PaymentStatus.VERIFIED.value
-----------+    else:
-----------+        status = PaymentStatus.REJECTED.value
-----------+    
-----------+    await db.organization_payments.update_one(
-----------+        {"id": payment_id},
-----------+        {"$set": {
-----------+            "status": status,
-----------+            "verified_by": admin_id,
-----------+            "verified_at": datetime.utcnow(),
-----------+            "rejection_reason": reason,
-----------+        }}
-----------+    )
-----------+    
-----------+    return {"message": "Payment verified" if approved else "Payment rejected"}
-----------+
-----------+@api_router.get("/organizations/payments/pending")
-----------+async def get_pending_organization_payments():
-----------+    """Get pending organization payments (admin)"""
-----------+    payments = await db.organization_payments.find({"status": "pending"}).sort("created_at", -1).to_list(50)
-----------+    return payments
-----------+
-----------+# Research Publication Endpoints
-----------+@api_router.post("/organizations/{org_id}/research/publish")
-----------+async def create_research_publication(org_id: str, title: str, condition_type: str, abstract: Optional[str] = None):
-----------+    """Create a research publication request"""
-----------+    org = await db.organizations.find_one({"id": org_id})
-----------+    if not org:
-----------+        raise HTTPException(status_code=404, detail="Organization not found")
-----------+    
-----------+    # Get statistics for the condition
-----------+    stats = await get_organization_statistics(org_id)
-----------+    condition_count = stats["condition_distribution"].get(condition_type, 0)
-----------+    
-----------+    publication = ResearchPublication(
-----------+        organization_id=org_id,
-----------+        title=title,
-----------+        abstract=abstract,
-----------+        condition_type=condition_type,
-----------+        total_patients=condition_count,
-----------+        data_summary=stats,
-----------+        publication_fee=500,  # Default fee in credits
-----------+    )
-----------+    
-----------+    await db.research_publications.insert_one(publication.dict())
-----------+    return {"message": "Research publication request created", "publication_id": publication.id, "fee": 500}
-----------+
-----------+@api_router.get("/research/publications")
-----------+async def get_research_publications(status: Optional[str] = None):
-----------+    """Get all research publications (admin)"""
-----------+    query = {}
-----------+    if status:
-----------+        query["status"] = status
-----------+    
-----------+    publications = await db.research_publications.find(query).sort("created_at", -1).to_list(100)
-----------+    return publications
-----------+
-----------+@api_router.post("/research/publications/{pub_id}/approve")
-----------+async def approve_research_publication(pub_id: str, admin_id: str):
-----------+    """Approve research publication (requires payment verification first)"""
-----------+    pub = await db.research_publications.find_one({"id": pub_id})
-----------+    if not pub:
-----------+        raise HTTPException(status_code=404, detail="Publication not found")
-----------+    
-----------+    if pub.get("payment_status") != "verified":
-----------+        raise HTTPException(status_code=400, detail="Payment must be verified first")
-----------+    
-----------+    await db.research_publications.update_one(
-----------+        {"id": pub_id},
-----------+        {"$set": {
-----------+            "status": ApprovalStatus.APPROVED.value,
-----------+            "approved_by": admin_id,
-----------+            "published_at": datetime.utcnow(),
-----------+        }}
-----------+    )
-----------+    
-----------+    return {"message": "Research publication approved and published"}
-----------+
-----------+@api_router.post("/research/publications/{pub_id}/pay")
-----------+async def pay_for_research_publication(pub_id: str, org_id: str):
-----------+    """Pay for research publication using organization credits"""
-----------+    pub = await db.research_publications.find_one({"id": pub_id})
-----------+    if not pub:
-----------+        raise HTTPException(status_code=404, detail="Publication not found")
-----------+    
-----------+    org = await db.organizations.find_one({"id": org_id})
-----------+    if not org:
-----------+        raise HTTPException(status_code=404, detail="Organization not found")
-----------+    
-----------+    fee = pub.get("publication_fee", 500)
-----------+    if org.get("credits", 0) < fee:
-----------+        raise HTTPException(status_code=400, detail=f"Insufficient credits. Required: {fee}, Available: {org.get('credits', 0)}")
-----------+    
-----------+    # Deduct credits
-----------+    await db.organizations.update_one(
-----------+        {"id": org_id},
-----------+        {"$inc": {"credits": -fee}}
-----------+    )
-----------+    
-----------+    # Update publication payment status
-----------+    await db.research_publications.update_one(
-----------+        {"id": pub_id},
-----------+        {"$set": {"payment_status": PaymentStatus.VERIFIED.value}}
-----------+    )
-----------+    
-----------+    return {"message": "Payment successful", "credits_deducted": fee}
