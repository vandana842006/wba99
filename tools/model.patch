-----------+@api_router.get("/organizations/{org_id}")
-----------+async def get_organization(org_id: str):
-----------+    """Get organization details"""
-----------+    org = await db.organizations.find_one({"id": org_id})
-----------+    if not org:
-----------+        raise HTTPException(status_code=404, detail="Organization not found")
-----------+    return org
-----------+
-----------+@api_router.post("/organizations/{org_id}/approve")
-----------+async def approve_organization(org_id: str, admin_id: str):
-----------+    """Approve organization and create org head account"""
-----------+    org = await db.organizations.find_one({"id": org_id})
-----------+    if not org:
-----------+        raise HTTPException(status_code=404, detail="Organization not found")
-----------+    
-----------+    # Update organization status
-----------+    await db.organizations.update_one(
-----------+        {"id": org_id},
-----------+        {"$set": {
-----------+            "status": OrganizationStatus.ACTIVE.value,
-----------+            "approval_status": ApprovalStatus.APPROVED.value,
-----------+            "approved_by": admin_id,
-----------+            "approved_at": datetime.utcnow(),
-----------+            "updated_at": datetime.utcnow(),
-----------+        }}
-----------+    )
-----------+    
-----------+    # Create organization head user account if not exists
-----------+    existing_user = await db.users.find_one({"email": org["head_email"]})
-----------+    if not existing_user:
-----------+        org_head_permissions = UserPermissions(
-----------+            walking_analysis=True,
-----------+            running_analysis=True,
-----------+            ai_analysis=True,
-----------+            ai_posture_ml=True
-----------+        )
-----------+        org_head = User(
-----------+            name=org["head_name"],
-----------+            email=org["head_email"],
-----------+            phone=org.get("head_phone"),
-----------+            role=UserRole.PHYSIO,  # Org head is a special physio
-----------+            organization_id=org_id,
-----------+            permissions=org_head_permissions,
-----------+            account_activated=True,
-----------+            credits=100,  # Demo credits
-----------+        )
-----------+        await db.users.insert_one(org_head.dict())
-----------+    else:
-----------+        # Update existing user to link with organization
-----------+        await db.users.update_one(
-----------+            {"email": org["head_email"]},
-----------+            {"$set": {"organization_id": org_id}}
-----------+        )
-----------+    
-----------+    return {"message": "Organization approved successfully", "organization_id": org_id}
-----------+
-----------+@api_router.post("/organizations/{org_id}/reject")
-----------+async def reject_organization(org_id: str, admin_id: str, reason: Optional[str] = None):
-----------+    """Reject organization signup"""
-----------+    await db.organizations.update_one(
-----------+        {"id": org_id},
-----------+        {"$set": {
-----------+            "status": OrganizationStatus.SUSPENDED.value,
-----------+            "approval_status": ApprovalStatus.REJECTED.value,
-----------+            "approved_by": admin_id,
-----------+            "rejection_reason": reason,
-----------+            "updated_at": datetime.utcnow(),
-----------+        }}
-----------+    )
-----------+    return {"message": "Organization rejected"}
